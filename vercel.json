{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/db push && node artifacts/api-server/build.mjs && pnpm --filter @workspace/finos-ai build",
  "outputDirectory": "artifacts/finos-ai/dist/public",
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "api/server.mjs"
    }
  },
  "routes": [
    {
      "src": "/api/ai/chat",
      "dest": "/api/ai/chat.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
