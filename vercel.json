{
  "version": 2,
  "buildCommand": "node artifacts/api-server/build.mjs && pnpm --filter @workspace/finos-ai build",
  "outputDirectory": "artifacts/finos-ai/dist/public",
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "api/server.mjs"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
