{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/finos-ai build",
  "outputDirectory": "artifacts/finos-ai/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
